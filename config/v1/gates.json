{
  "schema": "strategy-gate-config/1",
  "version": "v1",
  "benchmarks": {
    "BTC-USD": {"periods_per_year": 365, "max_gap_days": 3},
    "ETH-USD": {"periods_per_year": 365, "max_gap_days": 3},
    "SPY": {"periods_per_year": 252, "max_gap_days": 6},
    "QQQ": {"periods_per_year": 252, "max_gap_days": 6}
  },
  "integrity": {
    "gross_pnl_rel_tol": 1e-06,
    "equity_reconcile_rel_tol": 0.001,
    "summary_sharpe_abs_tol": 0.05,
    "summary_rel_tol": 0.01
  },
  "gates": {
    "settings": {
      "min_slippage_bps": 5.0,
      "realized_rate_min_fraction": 0.95
    },
    "sample": {
      "min_closed_trades": 100
    },
    "quality": {
      "min_sharpe_exclusive": 1.0,
      "min_profit_factor_exclusive": 1.3
    },
    "pain": {
      "max_drawdown_exclusive": 0.2
    },
    "neutral_book": {
      "max_abs_beta": 0.2,
      "min_obs_total": 60,
      "min_obs_each_side": 20
    },
    "risk_officer": {
      "signature_namespace": "strategy-gate-review"
    },
    "stress": {
      "fee_multiplier": 2.0,
      "slippage_multiplier": 2.0
    },
    "plateau": {
      "min_neighbor_ratio": 0.7
    },
    "recent": {
      "trailing_months": 12
    },
    "forward": {
      "min_days": 28,
      "max_gap_days": 30,
      "max_abs_return_diff": 0.02,
      "max_trade_count_diff_rel": 0.2,
      "min_shadow_trades": 5
    },
    "selection": {
      "min_deflated_sharpe": 0.95
    }
  },
  "deployment_limits": {
    "max_live_strategies": 1,
    "max_assets": 1,
    "max_initial_allocation_fraction": 0.05,
    "kill_switch_drawdown": 0.1,
    "note": "DEPLOYABLE is not permission to scale. Start with one strategy, one asset, small size, and a drawdown limit that closes everything."
  }
}
